# Copy to .env (never commit .env). Only needed for testnet / live modes.

# Binance Spot Testnet (https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Real account: Spot trading permission only, NO withdrawals, IP whitelist on.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Must be exactly YES to allow live trading with real money.
BINANCE_LIVE_CONFIRM=
